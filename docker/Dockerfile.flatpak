# Builds the Flatpak bundle of the GNOME frontend. Needs `docker run --privileged` (flatpak-builder uses bubblewrap).
ARG FEDORA=44
FROM fedora:${FEDORA}
RUN dnf install -y --setopt=install_weak_deps=False \
        flatpak flatpak-builder bubblewrap fuse fuse-overlayfs ostree bsdunzip \
        python3 python3-aiohttp python3-pyyaml python3-tomlkit curl \
        desktop-file-utils appstream xorg-x11-server-Xvfb dbus-daemon \
    && dnf clean all
